function faDayBox(isoDay){
  /* ForexFactory-style English date: "Thursday, Sep 26" + Persian beside it */
  try{
    const d=new Date(isoDay+'T12:00:00');
    const en=d.toLocaleDateString('en-US',{weekday:'long',month:'short',day:'numeric'});
    const wd=FA_DAY[d.toLocaleDateString('en-US',{weekday:'long'})]||'';
    const parts=new Intl.DateTimeFormat('en-u-ca-persian',{day:'numeric',month:'long'}).formatToParts(d);
    let day='',mon='';
    for(const p of parts){ if(p.type==='day') day=p.value; if(p.type==='month') mon=FA_MONTH[p.value]||p.value; }
    return `${esc(en)} <span style="color:var(--muted);font-weight:600">· ${wd} ${toFa(day)} ${mon}</span>`;
  }catch(e){ return esc(isoDay); }
}
function perDayCountdown(e){
  /* live segmented countdown — boxed digits, one segment per unit */
  let s=Math.max(0,Math.round(e.ts-Date.now()/1000));
  const d=Math.floor(s/86400); s%=86400; const h=Math.floor(s/3600); s%=3600; const m=Math.floor(s/60); s%=60;
  const two=n=>toFa(String(n).padStart(2,'0'));
  const seg=(v,l)=>`<span class="sg"><b>${v}</b><small>${l}</small></span>`;
  return (d?seg(toFa(d),'روز'):'')+seg(two(h),'ساعت')+seg(two(m),'دقیقه')+seg(two(s),'ثانیه');
}
