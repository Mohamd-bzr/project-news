# ── virtualenv ─────────────────────────────
.venv/

# ── local archives / snapshots (user-made) ─
freebuff.rar
freebuff.zip
*.rar
*.zip

# ── runtime state & caches (regenerated) ───
.mohmd_news.db
.mohmd_news.db-journal
.market_cache.json
.market_lab_cache.json
.content_studio_cache.json
.translate_cache.json
.feed_overrides.json
.reddit_scores.json
freebuff_tiers.db
freebuff_tiers.db-journal
# keystore holds the raw default API key
data/api_keys.json
.news_links.json
correlation.json
.mohmd_news.db-shm
.mohmd_news.db-wal
data/
logs/
.pytest_cache/

# ── local backups & scratch (94 MB of pre-redesign copies never go to git) ──
backups/
*.bak
.agents/skills/ui-ux-pro-max/
.zcodeignore

# ── python build artefacts ─────────────────
__pycache__/
*.py[cod]

# ── editor / agent scratch ─────────────────
.freebuff/
.cache/
*.log
*.log.err

# ── local user state (no secrets today, kept out so a future pasted
#    Telegram token can never be committed by accident) ──
settings.json
backups/settings.json*
backups/settings.json.bak*
